{
  "$schema": "https://capacitorjs.com/docs/cli/configuration",
  "appId": "com.deencompanion.app",
  "appName": "Deen Companion",
  "webDir": "public",
  "server": {
    "url": "https://ramadan-companion.vercel.app",
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 500,
      "backgroundColor": "#0f3d3e",
      "androidScaleType": "CENTER_INSIDE",
      "launchFadeOutDuration": 150,
      "showSpinner": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_deen",
      "iconColor": "#0f3d3e"
    },
    "Preferences": {
      "group": "group.com.deencompanion.app"
    }
  }
}
